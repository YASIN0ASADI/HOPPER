# Copy to /etc/recon-bot.env (systemd) or export in your shell. Never commit the real file.

# Required: token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token

# Optional: comma-separated Telegram user IDs allowed to use admin commands (/pack /sync /map /emojis)
ADMIN_IDS=

# Optional
# DB_PATH=/bot/monitor.db
# EMOJI_PACKS=CenterOfEmoji27799750,FluentEmojiSet5
# EMOJI_MAP=/bot/emoji_map.json
# PREMIUM_EMOJI=1
